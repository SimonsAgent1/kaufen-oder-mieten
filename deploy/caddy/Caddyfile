{
	email simon.muchau@freenet.de
	# User service: Fritz!Box WAN 443 → LAN 8443. Port 80 stays AdGuard.
	https_port 8443
	http_port 8080
	auto_https disable_redirects
}

kauf-oder-mieten.de, www.kauf-oder-mieten.de {
	# Let's Encrypt TLS-ALPN-01 on LAN 8443 (WAN 443 is forwarded). No DNS TXT. See CLOUDDNS-CERTS.md.
	tls {
		issuer acme {
			disable_http_challenge
			alt_tlsalpn_port 8443
		}
	}

	reverse_proxy https://127.0.0.1:8000 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
