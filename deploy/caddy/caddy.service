[Unit]
Description=Caddy TLS front for kauf-oder-mieten.de
After=network-online.target buy-vs-rent.service
Wants=network-online.target

[Service]
Type=notify
Environment=PATH=%h/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Europe/Berlin
EnvironmentFile=-%h/.config/caddy/netcup.env
ExecStart=%h/bin/caddy run --config %h/.config/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
